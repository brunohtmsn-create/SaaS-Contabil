{
  "name": "@saas-contabil/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev --schema=../../packages/database/prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma",
    "db:seed": "tsx ../../packages/database/src/seed.ts",
    "db:studio": "prisma studio --schema=../../packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@saas-contabil/shared": "workspace:*",
    "@saas-contabil/database": "workspace:*",
    "@saas-contabil/credentials": "workspace:*",
    "@saas-contabil/audit": "workspace:*",
    "@saas-contabil/storage": "workspace:*",
    "@saas-contabil/scraper": "workspace:*",
    "@saas-contabil/normalizer": "workspace:*",
    "@saas-contabil/conciliation": "workspace:*",
    "@saas-contabil/fiscal": "workspace:*",
    "@saas-contabil/contabil": "workspace:*",
    "@saas-contabil/portals": "workspace:*",
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/websocket": "^10.0.1",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.0",
    "bcrypt": "^5.1.1",
    "decimal.js": "^10.4.3",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "@types/bcrypt": "^5.0.2",
    "tsx": "^4.16.0",
    "prisma": "^5.16.0"
  }
}
