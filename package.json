{
  "name": "saas-contabil",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22", "pnpm": ">=9" },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:migrate": "pnpm --filter @saas-contabil/api run db:migrate",
    "db:seed": "pnpm --filter @saas-contabil/api run db:seed",
    "db:studio": "pnpm --filter @saas-contabil/api run db:studio"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "prettier": "^3.3.0",
    "eslint": "^10.4.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4"
  }
}
